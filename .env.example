# === AI Major Recommendation - environment configuration ===
# Copy this file to ".env" and fill in your values:
#   cp .env.example .env

# Required for REAL recommendations: your OpenAI API key.
# Get one at https://platform.openai.com/api-keys
# NOTE: the key must have available credits/quota, or the API returns a 429
# "insufficient_quota" error. Add a balance at:
#   https://platform.openai.com/settings/organization/billing
OPENAI_API_KEY=sk-your-key-here

# Optional: run the app in FREE offline DEMO mode. When set to 1/true, the app
# serves realistic canned recommendations with NO API calls and NO key needed.
# Great for trying the UI or presenting the app. Leave as 0 to use real OpenAI.
DEMO_MODE=0

# Optional: which OpenAI chat model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: secret key used to sign Flask session cookies.
# Change this to any long random string for your own deployment.
FLASK_SECRET_KEY=change-me-to-a-long-random-string
