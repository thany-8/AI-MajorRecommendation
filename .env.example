# === AI Major Recommendation - environment configuration ===
# Copy this file to ".env" and fill in your values:
#   cp .env.example .env

# Required for REAL recommendations: your Google Gemini API key.
# Get a FREE key (no billing needed) at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: run the app in FREE offline DEMO mode. When set to 1/true, the app
# serves realistic canned recommendations with NO API calls and NO key needed.
# Great for trying the UI or presenting the app. Leave as 0 to use real Gemini.
DEMO_MODE=0

# Optional: when real Gemini calls hit quota/rate limits, automatically switch
# that user session to free demo recommendations instead of showing an error.
# Set to 0 to disable this auto-fallback behavior.
AUTO_DEMO_FALLBACK=1

# Optional: which Gemini model to use (default: gemini-3.5-flash).
# Other options include gemini-flash-latest and gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.5-flash

# Optional: where to store user profiles, past sessions and feedback.
# Leave unset to use a local SQLite file at instance/majormatch.db (no setup).
# For PostgreSQL, point this at your database, e.g.:
#   DATABASE_URL=postgresql://user:password@localhost:5432/majormatch
# If the database can't be reached the app still runs; persistence is disabled.
# DATABASE_URL=

# Optional: secret key used to sign Flask session cookies.
# Change this to any long random string for your own deployment.
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# --- Caching (avoid re-hitting Gemini for repeated/similar profiles) ---------
# Set to 0 to disable the in-process cache of initial recommendations.
CACHE_ENABLED=1
# Cache time-to-live (seconds) and maximum number of cached profiles.
CACHE_TTL=3600
CACHE_MAXSIZE=512

# --- Data-driven grounding (sanity-check/re-rank against real major data) ----
# Set to 0 to disable grounding recommendations in data/majors.json.
DATASET_ENABLED=1

# --- Rate limiting (Flask-Limiter, per user/session) -------------------------
# Set to 0 to disable rate limiting entirely.
RATELIMIT_ENABLED=1
# Per-endpoint limits (see the Flask-Limiter string syntax).
RATELIMIT_START=15 per minute
RATELIMIT_CHAT=40 per minute
RATELIMIT_DEFAULT=60 per minute
RATELIMIT_AUTH=10 per minute
# Storage backend for limit counters. Use redis://... for multi-process deploys.
RATELIMIT_STORAGE_URI=memory://

# --- Accounts & security -----------------------------------------------------
# CSRF protection for state-changing API requests (double-submit token).
# Set to 0 only for local API testing.
CSRF_ENABLED=1

# --- Logging & error monitoring ----------------------------------------------
# LOG_LEVEL: DEBUG/INFO/WARNING/ERROR. LOG_FORMAT: "json" (structured) or "plain".
LOG_LEVEL=INFO
LOG_FORMAT=json
# Optional: enable Sentry error monitoring (requires `pip install sentry-sdk`).
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

